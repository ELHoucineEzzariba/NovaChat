{
  // Next.js liest diese Datei über einen JSON5-toleranten Parser ein, Kommentare
  // sind hier also sicher (im Gegensatz zu package.json/site.webmanifest, die von
  // strikten JSON-Parsern wie npm bzw. dem Browser gelesen werden).
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Erlaubt Imports wie "@/components/..." statt langer relativer Pfade
    // ("../../../components/..."), aufgelöst relativ zu src/.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
